# Образец. Скопировать в .env.local (он вне git). Нужен только для запуска SPA
# отдельно от Aspire: `yarn nx serve web`. Под `yarn dev` те же переменные
# подставляет AppHost, и они побеждают оба файла.
# Реестр приватных файлов - docs/guides/local-configuration.md.

# Идентификатор клиента Logto. Значение выдаёт сам Logto при первой настройке,
# постоянного у него нет - взять в консоли на http://localhost:3482, раздел
# приложений. Пока значение пустое, вход выключен.
VITE_OIDC_CLIENT_ID=

# Остальное нужно, только если адреса расходятся с .env.development.
# VITE_API_BASE_URL=http://localhost:5249
# VITE_OIDC_AUTHORITY=http://localhost:3481/oidc
# VITE_OIDC_RESOURCE=https://api.dotnet-vue3-template-ru.local
