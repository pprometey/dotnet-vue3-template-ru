{
  "name": "architecture-tests",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "implicitDependencies": [
    "api",
    "core-application",
    "core-domain",
    "core-infrastructure"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "dotnet build tests/DotnetVue3TemplateRu.ArchitectureTests/DotnetVue3TemplateRu.ArchitectureTests.csproj -c Debug --no-dependencies"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "dotnet test --project tests/DotnetVue3TemplateRu.ArchitectureTests/DotnetVue3TemplateRu.ArchitectureTests.csproj -c Debug --no-build"
      }
    }
  }
}
