<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Источники пакетов фиксируются в репозитории, а не берутся из машинного конфига,
    чтобы восстановление было воспроизводимым на любой машине и в CI.
    <clear /> отбрасывает источники, унаследованные от пользовательского/машинного NuGet.config.
    Пока один источник - официальный nuget.org. По мере необходимости (например, приватный
    фид с внутренними библиотеками) сюда добавляются новые <add> и, при >1 источника,
    packageSourceMapping. См. ADR-0015.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
