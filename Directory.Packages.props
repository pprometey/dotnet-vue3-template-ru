<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Static code analysis -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.15.0.120848" />
    <!-- API / versioning / OpenAPI -->
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <!-- Явный пин поверх транзитивной 2.0.0: AspNetCore.OpenApi тянет уязвимую 2.0.0
         (NU1903 GHSA-v5pm-xwqc-g5wc, исправлено в 2.7.5 для линейки 2.x). Зависимость
         AspNetCore.OpenApi - ">= 2.0.0" (нижняя граница), 2.7.5 её удовлетворяет; если
         будущий AspNetCore.OpenApi поднимет границу выше - NuGet упадёт NU1605 (downgrade),
         не молча, и пин поднимут. Типы OpenApi используются напрямую в
         Serialization/*SchemaTransformer.cs, так что это законная прямая зависимость. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.8" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.14.14" />
    <!-- EF Core / PostgreSQL -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8" />
    <!-- Явный пин ядра EF Core. Infrastructure компилируется против 10.0.8, потому что
         столько тянет Design, - но Design помечен PrivateAssets и наружу не выходит.
         Потребителю без этого пина доставалась бы версия от провайдера (ниже), и сборка
         падала бы на CS1705, а прогон - на FileNotFoundException. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Имена таблиц и колонок в snake_case (ADR-0007): без этого PostgreSQL требует
         кавычек в каждом ручном запросе к таблице, созданной EF Core. -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Явный пин Npgsql: его тянут транзитивно и EF-провайдер, и WolverineFx.Postgresql.
         Без пина расхождение их нижних границ даёт NU1605 (downgrade) при центральном
         управлении версиями. Пин поднимают, когда любой из двух потребует более новую. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.8" />
    <!-- Wolverine -->
    <PackageVersion Include="WolverineFx" Version="6.5.1" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.5.1" />
    <PackageVersion Include="WolverineFx.FluentValidation" Version="6.5.1" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.5.1" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.5.1" />
    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="12.0.0" />
    <!-- Extensions / DI / config -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <!-- Observability -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <!-- Tests -->
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <PackageVersion Include="TUnit" Version="0.87.8" />
    <PackageVersion Include="Verify.TUnit" Version="31.4.3" />
  </ItemGroup>
</Project>
