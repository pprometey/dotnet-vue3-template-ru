# Node / Nx / yarn
node_modules/
dist/
.nx/
coverage/
storybook-static/

# Generated artifacts (regenerated by build / orval)
# OpenAPI-документ - коммитимый контракт (git-diff-guard стережёт дрейф); прочее в openapi/ - мусор сборки.
apps/backend/DotnetVue3TemplateRu.Api/openapi/*
!apps/backend/DotnetVue3TemplateRu.Api/openapi/DotnetVue3TemplateRu.Api.json
libs/frontend/api-client/src/generated/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# .NET
bin/
obj/
TestResults/
*.user

# Verify snapshot testing -- received files are temporary, verified files are committed
*.received.*

# IDE
.vs/
.idea/

# Aspire generated integration files (machine-specific, recreated on yarn dev)
.aspire/

# Aspire CLI agent skills (generated)
.agents/

.claude/worktrees

# Приватные и локальные файлы - реестр в docs/guides/local-configuration.md.
# Паттерны закрывают класс имён, а не конкретный файл: новый приватный файл,
# названный по конвенции, игнорируется сразу. Образцы <файл>.example коммитятся.
appsettings.Local.json
.env
.env.*
!.env.development
!.env.*.example
*.private.*
!*.private.*.example
secrets.json
*.secrets.json
CLAUDE.local.md
.claude/settings.local.json

# Dev backend logs (Serilog file sink)
logs/
**/logs/

# Console output from local runs belongs under logs/ too; this catches strays
*.log
