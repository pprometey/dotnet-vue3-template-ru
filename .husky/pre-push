# Если весь пушимый диапазон коммитов затрагивает только docs/, пропускаем build/test.
skip=1
has_ref=0
while read -r local_ref local_sha remote_ref remote_sha; do
  has_ref=1
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base=$(git merge-base main "$local_sha" 2>/dev/null) || base=""
  else
    base="$remote_sha"
  fi
  if [ -z "$base" ]; then
    skip=0
    continue
  fi
  files=$(git diff --name-only "$base" "$local_sha")
  if [ -n "$files" ] && printf '%s\n' "$files" | grep -qv '^docs/'; then
    skip=0
  fi
done

if [ "$has_ref" = "1" ] && [ "$skip" = "1" ]; then
  echo "Пуш затрагивает только docs/, пропускаем build/test/dotnet build."
  exit 0
fi

# Сборка и тесты только изменённого кода (и .NET, и фронтенд) - nx affected.
yarn nx affected -t build --parallel=3
yarn nx affected -t test

# Полная сборка .NET-решения целиком. nx affected собирает проекты по
# отдельности и не видит сам .slnx, поэтому битый состав/пути проектов в нём
# (несуществующий проект, неверный путь) этот шаг ловит до пуша.
dotnet build DotnetVue3TemplateRu.slnx

# OpenAPI-спека - коммитимый контракт. Сборка выше её перегенерировала; сравниваем
# с HEAD (закоммиченной версией, которую и пушим): если разошлась - контроллеры
# поменяли без перегенерации/коммита спеки.
git diff --exit-code HEAD -- apps/backend/DotnetVue3TemplateRu.Api/openapi/DotnetVue3TemplateRu.Api.json \
  || { echo "OpenAPI-спека устарела/не закоммичена: перегенерируй (dotnet build API) и закоммить DotnetVue3TemplateRu.Api.json"; exit 1; }
