{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "dotnet-vue3-template-ru-db": ""
  },

  "Jwt": {
    "Authority": "",
    "Audience": "https://api.dotnet-vue3-template-ru.local"
  },

  "Cultures": {
    "DefaultCulture": "ru",
    "SupportedCultures": [
      { "Culture": "ru" },
      { "Culture": "en" },
      { "Culture": "kk" }
    ]
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Messaging": {
    "Durability": "Persistent"
  },

  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  }
}
