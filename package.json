{
  "name": "dotnet-vue3-template-ru",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.5.0",
  "workspaces": [
    "apps/frontend/*",
    "libs/frontend/*",
    "aspire-apphost"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "nx run aspire-host:serve",
    "lint:affected": "nx affected --target=lint --parallel=3",
    "format:check": "nx format:check",
    "format:write": "nx format:write",
    "build:affected": "nx affected --target=build",
    "test": "nx run-many --target=test",
    "test:affected": "nx affected --target=test",
    "generate:api-client": "nx run api-client:generate",
    "aspire:start": "yarn --cwd aspire-apphost run aspire:start",
    "aspire:build": "yarn --cwd aspire-apphost run aspire:build",
    "aspire:dev": "yarn --cwd aspire-apphost run aspire:dev"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@faker-js/faker": "^9.3.0",
    "@nx/eslint": "20.3.3",
    "@nx/js": "20.3.3",
    "@nx/vite": "20.3.3",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/vue3-vite": "^10.4.6",
    "@testing-library/user-event": "^14.5.2",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "5.2.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "0.7.0",
    "eslint": "9.17.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-vue": "9.32.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "happy-dom": "^15.11.7",
    "husky": "9.1.7",
    "msw": "^2.7.0",
    "msw-storybook-addon": "^2.0.4",
    "nx": "20.3.3",
    "orval": "8.19.0",
    "prettier": "3.4.2",
    "sass-embedded": "^1.83.0",
    "storybook": "^10.4.6",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.0.7",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "3.2.4",
    "vue-eslint-parser": "9.4.3",
    "vue-tsc": "2.2.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tanstack/vue-query": "5.62.8",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "element-plus": "^2.11.0",
    "oidc-client-ts": "^3.1.0",
    "pinia": "2.3.0",
    "vue": "3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "4.5.0"
  },
  "msw": {
    "workerDirectory": [
      "apps/frontend/web/public"
    ]
  }
}
