# Адреса для запуска SPA вне Aspire (`nx serve web`). Под `yarn dev` те же
# переменные подставляет AppHost из адресов поднятых ресурсов, и они побеждают
# этот файл. Прод-сборку (vite build) файл не затрагивает - Vite грузит его
# только в dev-режиме.
VITE_API_BASE_URL=http://localhost:5249
VITE_OIDC_AUTHORITY=http://localhost:3481/oidc
VITE_OIDC_RESOURCE=https://api.dotnet-vue3-template-ru.local

# Идентификатор клиента Logto выдаёт сам при первой настройке, поэтому
# постоянного значения у него нет и закоммитить его нельзя. Под `yarn dev` его
# подставляет AppHost. Для запуска SPA отдельно возьмите значение из консоли
# Logto и положите в .env.local (он в gitignore). Пока значение пустое, вход
# выключен: приложение работает как без провайдера.
VITE_OIDC_CLIENT_ID=
