{
  "name": "api-unit-tests",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "implicitDependencies": ["api"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "dotnet build tests/DotnetVue3TemplateRu.Api.UnitTests/DotnetVue3TemplateRu.Api.UnitTests.csproj -c Debug --no-dependencies"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "dotnet test --project tests/DotnetVue3TemplateRu.Api.UnitTests/DotnetVue3TemplateRu.Api.UnitTests.csproj -c Debug --no-build"
      }
    }
  }
}
